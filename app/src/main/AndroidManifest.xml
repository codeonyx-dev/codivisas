<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".BcvAquiApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BcvAqui">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BcvAqui.Splash" />

        <!-- Íconos por paleta: solo los alias llevan MAIN/LAUNCHER; Azul es el predeterminado. -->
        <activity-alias
            android:name=".LauncherAzul"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_azul"
            android:roundIcon="@mipmap/ic_launcher_azul_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherOnix"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_onix"
            android:roundIcon="@mipmap/ic_launcher_onix_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherMorado"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_morado"
            android:roundIcon="@mipmap/ic_launcher_morado_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherEsmeralda"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_esmeralda"
            android:roundIcon="@mipmap/ic_launcher_esmeralda_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".widget.RateWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.codeonyx.bcvaqui.widget.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/rate_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.SpreadWidgetProvider"
            android:exported="true"
            android:label="@string/widget_spread_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/spread_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.ConverterWidgetProvider"
            android:exported="true"
            android:label="@string/widget_converter_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.codeonyx.bcvaqui.widget.ACTION_CYCLE_AMOUNT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/converter_widget_info" />
        </receiver>

        <receiver
            android:name=".worker.BootCompletedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".update.UpdateDownloadReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.codeonyx.bcvaqui.update.ACTION_INSTALL_UPDATE" />
                <action android:name="com.codeonyx.bcvaqui.update.ACTION_INSTALL_DOWNLOADED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
