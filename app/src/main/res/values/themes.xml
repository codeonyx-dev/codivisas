<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BcvAqui" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="Theme.BcvAqui.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launcher_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/launcher_bg</item>
        <item name="postSplashScreenTheme">@style/Theme.BcvAqui</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="Theme.BcvAqui.Splash.Azul">
        <item name="windowSplashScreenBackground">@color/launcher_bg_azul</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground_azul</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/launcher_bg_azul</item>
    </style>
    <style name="Theme.BcvAqui.Splash.Onix">
        <item name="windowSplashScreenBackground">@color/launcher_bg_onix</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground_onix</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/launcher_bg_onix</item>
    </style>
    <style name="Theme.BcvAqui.Splash.Morado">
        <item name="windowSplashScreenBackground">@color/launcher_bg_morado</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground_morado</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/launcher_bg_morado</item>
    </style>
    <style name="Theme.BcvAqui.Splash.Esmeralda">
        <item name="windowSplashScreenBackground">@color/launcher_bg_esmeralda</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground_esmeralda</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/launcher_bg_esmeralda</item>
    </style>
</resources>
